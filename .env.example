# Copy to .env — it is gitignored. Both the Vite dev server and `vercel dev`
# read it; on Vercel set the same keys under Project → Settings → Environment Variables.

# The database this deployment owns. Any Postgres 12+ will do: a local one, Neon,
# Supabase, RDS. Neon's free tier is the quickest way to get a URL to paste here.
#   postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Let the browser supply its own connection string instead of using DATABASE_URL.
# Off by default: an endpoint that dials whatever address it is handed is a port
# scanner with a public URL. Turn it on for a scratch deployment you want other
# people to be able to point at their own database — and only then.
ALLOW_CLIENT_DATABASE_URL=false
